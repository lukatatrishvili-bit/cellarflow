{
  "entities": {
    "winery": {
      "title": "Winery",
      "description": "Information about the winery site",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "tank": {
      "title": "Tank",
      "description": "Winery tank or storage vessel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["stainless_steel", "qvevri", "barrel", "plastic", "concrete", "other"] },
        "capacity": { "type": "number" },
        "currentVolume": { "type": "number" },
        "location": { "type": "string" },
        "shape": { "type": "string" },
        "coolingJacket": { "type": "boolean" },
        "tempControl": { "type": "boolean" },
        "currentTemp": { "type": "number" },
        "status": { "type": "string", "enum": ["empty", "occupied", "fermenting", "storage", "cleaning", "maintenance"] },
        "currentLotId": { "type": "string" },
        "notes": { "type": "string" },
        "lastCleaningDate": { "type": "string" },
        "lastOperationDate": { "type": "string" }
      },
      "required": ["id", "name", "type", "capacity", "currentVolume", "status"]
    },
    "lot": {
      "title": "Wine Lot",
      "description": "A traceable wine batch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "wineName": { "type": "string" },
        "vintage": { "type": "number" },
        "variety": { "type": "string" },
        "vineyard": { "type": "string" },
        "region": { "type": "string" },
        "harvestDate": { "type": "string" },
        "grapeQuantity": { "type": "number" },
        "initialVolume": { "type": "number" },
        "currentVolume": { "type": "number" },
        "type": { "type": "string", "enum": ["white", "red", "rose", "amber", "sparkling", "fortified", "base_wine", "distillate"] },
        "productionMethod": { "type": "string" },
        "stage": { "type": "string", "enum": ["crushing", "fermentation", "maceration", "pressing", "aging", "stabilization", "filtration", "bottling", "bottled", "sold"] },
        "tanks": { "type": "array" },
        "responsibleWinemaker": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "code", "wineName", "vintage", "currentVolume", "type", "stage"]
    },
    "transfer": {
      "title": "Wine Transfer",
      "description": "Racking, blending, or moving wine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "sourceTankId": { "type": "string" },
        "destTankId": { "type": "string" },
        "lotId": { "type": "string" },
        "volume": { "type": "number" },
        "lossVolume": { "type": "number" },
        "reason": { "type": "string" },
        "pump": { "type": "string" },
        "operator": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "sourceTankId", "destTankId", "lotId", "volume"]
    },
    "fermentation": {
      "title": "Fermentation",
      "description": "An active fermentation process",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lotId": { "type": "string" },
        "tankId": { "type": "string" },
        "startDate": { "type": "string" },
        "yeast": { "type": "string" },
        "type": { "type": "string", "enum": ["alcoholic", "malolactic", "spontaneous", "controlled"] },
        "initialSugar": { "type": "number" },
        "tempRange": { "type": "string" },
        "targetDryness": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "slow", "stuck", "finished"] },
        "notes": { "type": "string" }
      },
      "required": ["id", "lotId", "tankId", "startDate", "status"]
    },
    "fermentation_log": {
      "title": "Fermentation Log",
      "description": "Daily fermentation reading",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fermentationId": { "type": "string" },
        "date": { "type": "string" },
        "temp": { "type": "number" },
        "density": { "type": "number" },
        "sugar": { "type": "number" },
        "pH": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "fermentationId", "date", "temp", "density"]
    },
    "lab_result": {
      "title": "Lab Result",
      "description": "Chemical analysis parameters of a wine lot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lotId": { "type": "string" },
        "tankId": { "type": "string" },
        "date": { "type": "string" },
        "alcohol": { "type": "number" },
        "pH": { "type": "number" },
        "totalAcidity": { "type": "number" },
        "volatileAcidity": { "type": "number" },
        "freeSO2": { "type": "number" },
        "totalSO2": { "type": "number" },
        "residualSugar": { "type": "number" },
        "density": { "type": "number" },
        "tastingNote": { "type": "string" },
        "technician": { "type": "string" }
      },
      "required": ["id", "lotId", "date"]
    },
    "additive": {
      "title": "Additive",
      "description": "Treatment added to a wine batch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lotId": { "type": "string" },
        "tankId": { "type": "string" },
        "date": { "type": "string" },
        "productName": { "type": "string" },
        "productType": { "type": "string" },
        "dose": { "type": "string" },
        "totalAmount": { "type": "number" },
        "operator": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "lotId", "date", "productName", "totalAmount"]
    },
    "inventory": {
      "title": "Inventory Item",
      "description": "Stock of bottles, corks, yeasts, additives",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minStock": { "type": "number" },
        "costPerUnit": { "type": "number" },
        "expirationDate": { "type": "string" },
        "storageLocation": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name", "category", "quantity", "unit"]
    },
    "bottling": {
      "title": "Bottling Record",
      "description": "Wines bottled and placed in storage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "lotId": { "type": "string" },
        "sourceTankId": { "type": "string" },
        "volume": { "type": "number" },
        "bottleSize": { "type": "string" },
        "bottleCount": { "type": "number" },
        "closureType": { "type": "string" },
        "labelVersion": { "type": "string" },
        "operator": { "type": "string" }
      },
      "required": ["id", "date", "lotId", "volume", "bottleCount"]
    },
    "barrel": {
      "title": "Barrel",
      "description": "Oak barrel records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "volume": { "type": "number" },
        "cooper": { "type": "string" },
        "oakOrigin": { "type": "string" },
        "toastLevel": { "type": "string" },
        "currentLotId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "volume"]
    },
    "qvevri": {
      "title": "Qvevri",
      "description": "Traditional Georgian clay amphora",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "volume": { "type": "number" },
        "location": { "type": "string" },
        "isBuried": { "type": "boolean" },
        "waxLimeStatus": { "type": "string" },
        "currentLotId": { "type": "string" }
      },
      "required": ["id", "volume"]
    },
    "cleaning": {
      "title": "Cleaning Record",
      "description": "Equipment cleaning and sanitation events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "equipmentId": { "type": "string" },
        "equipmentType": { "type": "string" },
        "method": { "type": "string" },
        "productUsed": { "type": "string" },
        "concentration": { "type": "string" },
        "operator": { "type": "string" }
      },
      "required": ["id", "date", "equipmentId", "equipmentType", "method"]
    },
    "task": {
      "title": "Cellar Task",
      "description": "Pending task inside the winery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "relatedType": { "type": "string" },
        "relatedId": { "type": "string" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "assignedTo": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "notes": { "type": "string" }
      },
      "required": ["id", "title", "dueDate", "priority", "status"]
    },
    "audit_log": {
      "title": "Audit Log",
      "description": "Traceability audit trail for every action",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "relatedType": { "type": "string" },
        "relatedId": { "type": "string" }
      },
      "required": ["id", "timestamp", "action", "details"]
    },
    "supplier": {
      "title": "Supplier",
      "description": "Vendor profiles for raw materials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "itemsSupplied": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/wineries/{wineryId}": {
      "schema": "winery",
      "description": "Details of the winery setup"
    },
    "/wineries/{wineryId}/tanks/{tankId}": {
      "schema": "tank",
      "description": "All tanks inside this winery"
    },
    "/wineries/{wineryId}/lots/{lotId}": {
      "schema": "lot",
      "description": "Wine lots managed"
    },
    "/wineries/{wineryId}/transfers/{transferId}": {
      "schema": "transfer",
      "description": "Racking, moves, and blending transactions"
    },
    "/wineries/{wineryId}/fermentations/{fermentationId}": {
      "schema": "fermentation",
      "description": "Active alcoholic/MLF fermentations"
    },
    "/wineries/{wineryId}/fermentations/{fermentationId}/logs/{logId}": {
      "schema": "fermentation_log",
      "description": "Daily gravity/temp readings"
    },
    "/wineries/{wineryId}/lab_results/{resultId}": {
      "schema": "lab_result",
      "description": "All lab parameters registered"
    },
    "/wineries/{wineryId}/additives/{addId}": {
      "schema": "additive",
      "description": "Product additions made to lots"
    },
    "/wineries/{wineryId}/inventory/{invId}": {
      "schema": "inventory",
      "description": "Stock levels of materials"
    },
    "/wineries/{wineryId}/bottling/{bottleId}": {
      "schema": "bottling",
      "description": "Bottled outputs"
    },
    "/wineries/{wineryId}/barrels/{barrelId}": {
      "schema": "barrel",
      "description": "Wood aging structures"
    },
    "/wineries/{wineryId}/qvevri/{qvevriId}": {
      "schema": "qvevri",
      "description": "Georgian qvevri aging elements"
    },
    "/wineries/{wineryId}/cleaning/{cleanId}": {
      "schema": "cleaning",
      "description": "Sanitation logs"
    },
    "/wineries/{wineryId}/tasks/{taskId}": {
      "schema": "task",
      "description": "User scheduled procedures"
    },
    "/wineries/{wineryId}/audit_logs/{auditId}": {
      "schema": "audit_log",
      "description": "Traceability audit trail of updates"
    },
    "/wineries/{wineryId}/suppliers/{supId}": {
      "schema": "supplier",
      "description": "Supplier information"
    }
  }
}
