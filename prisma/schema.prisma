datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String   @id @default(cuid())
  username             String   @unique
  email                String   @unique
  fullName             String
  role                 String
  language             String   @default("en")
  phone                String   @default("")
  whatsappOptIn        Boolean  @default(false)
  passwordHash         String
  emailVerified        Boolean  @default(false)
  verifyTokenHash      String?
  verifyTokenExpires   BigInt?
  resetTokenHash       String?
  resetTokenExpires    BigInt?
  isDemo               Boolean  @default(false)
  activeOrganizationId String?
  enabledModules       Json?
  enabledWidgets       Json?
  registrationComplete Boolean  @default(true)
  accountEnabled       Boolean  @default(true)
  /** pending | approved | rejected — self-service signups start pending. */
  approvalStatus       String   @default("approved")
  approvalRequestedAt  DateTime?
  approvalDecidedAt    DateTime?
  approvalDecidedBy    String?
  approvalTokenHash    String?
  approvalTokenExpires BigInt?
  sessionVersion       Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships               Membership[]
  aiNotificationOutbox      AiNotificationOutbox[]
  aiNotificationPreferences AiNotificationPreference[]
  aiNotificationReadStates  AiNotificationReadState[]
  aiKnowledgeDocuments      AiKnowledgeDocument[]
  aiPushSubscriptions       AiPushSubscription[]

  @@index([approvalStatus, approvalRequestedAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]

  companyProfile            CompanyProfile?
  vessels                   Vessel[]
  lots                      WineLot[]
  fermlogs                  DailyFermLog[]
  lablogs                   LabAnalysis[]
  inventory                 InventoryItem[]
  tasks                     Task[]
  notes                     Note[]
  blocks                    VineyardBlock[]
  vineyardProjects          VineyardPlantingProject[]
  phenologyLogs             PhenologyRecord[]
  sprays                    SprayRecord[]
  scoutings                 ScoutingRecord[]
  soilRecords               SoilAnalysisRecord[]
  samplings                 GrapeSamplingRecord[]
  harvests                  HarvestRecord[]
  irrigationLogs            IrrigationRecord[]
  fertilizerLogs            FertilizationRecord[]
  auditLogs                 AuditLog[]
  bottlingRuns              BottlingRun[]
  transfers                 Transfer[]
  grapeIntakes              GrapeIntake[]
  cellarOps                 CellarOp[]
  costEntries               CostEntry[]
  storageLocations          StorageLocation[]
  stockMovements            StockMovement[]
  salesDispatches           SalesDispatch[]
  salesOrders               SalesOrder[]
  commandExecutions         CommandExecution[]
  subscription              OrganizationSubscription?
  billingPayments           BillingPayment[]
  whatsappDeliveries        WhatsAppDelivery[]
  subscriptionRequests      SubscriptionRequest[]
  subscriptionAudits        SubscriptionAudit[]
  productionUsage           AnnualProductionUsage[]
  aiModelCallUsage          AiModelCallUsage[]
  aiModelCallTelemetry      AiModelCallTelemetry[]
  aiMonitoringRuns          AiMonitoringRun[]
  aiNotificationOutbox      AiNotificationOutbox[]
  aiNotificationPreferences AiNotificationPreference[]
  aiNotificationReadStates  AiNotificationReadState[]
  aiKnowledgeDocuments      AiKnowledgeDocument[]
  aiKnowledgeChunks         AiKnowledgeChunk[]
  aiPushSubscriptions       AiPushSubscription[]

  /// Authoritative JSONB snapshot of the full winery/vineyard ERP state.
  /// The detailed collection tables below are retained for compatibility but
  /// are not the production source of truth for this milestone.
  state OrganizationState?
}

model OrganizationState {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Json
  version        Int          @default(1)
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// Atomic, organization-scoped model-call reservations. Kept outside the
/// client-synced JSONB snapshot so multiple Cloud Run instances share one hard
/// daily ceiling.
model AiModelCallUsage {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageDate      DateTime     @db.Date
  callCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, usageDate])
  @@index([usageDate])
}

/// Metadata-only operational telemetry for winery-intelligence provider calls.
/// Prompts, responses, questions, entity ids, and winery values are never stored.
model AiModelCallTelemetry {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purpose        String
  agent          String?
  model          String
  status         String       @default("running")
  errorCategory  String?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  latencyMs      Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
}

/// One lease-protected deterministic monitoring pass for one winery and
/// cadence window. This prevents overlapping schedulers from evaluating and
/// notifying the same winery twice.
model AiMonitoringRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cadence        String
  windowStart    DateTime
  status         String       @default("running")
  claimToken     String
  attemptCount   Int          @default(1)
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  failedAt       DateTime?
  evaluated      Int          @default(0)
  created        Int          @default(0)
  escalated      Int          @default(0)
  autoResolved   Int          @default(0)
  outboxQueued   Int          @default(0)
  wineryStatus   String?
  briefing       String?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, cadence, windowStart])
  @@index([status, updatedAt])
  @@index([organizationId, createdAt])
}

/// Transactional hand-off between finding detection and channel delivery
/// workers. Payloads contain only the validated finding projection; provider
/// credentials and contact details never enter this table.
model AiNotificationOutbox {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventKey          String
  channel           String       @default("email")
  findingId         String
  findingDedupeKey  String
  recipientUsername String
  recipient         User         @relation(fields: [recipientUsername], references: [username], onDelete: Cascade)
  recipientRole     String
  severity          String
  priority          Int
  area              String
  payload           Json
  status            String       @default("pending")
  attemptCount      Int          @default(0)
  availableAt       DateTime     @default(now())
  claimToken        String?
  claimedAt         DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, eventKey, recipientUsername, channel], map: "AiNotificationOutbox_organizationId_eventKey_recipientUsern_key")
  @@index([status, availableAt])
  @@index([organizationId, recipientUsername, createdAt], map: "AiNotificationOutbox_organizationId_recipientUsername_creat_idx")
}

/// Explicit, winery-scoped user consent for proactive AI delivery. Email is
/// disabled by default and `emailEnabledAt` prevents retroactive backlog sends.
model AiNotificationPreference {
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  username            String
  user                User         @relation(fields: [username], references: [username], onDelete: Cascade)
  emailEnabled        Boolean      @default(false)
  emailEnabledAt      DateTime?
  pushEnabled         Boolean      @default(false)
  pushEnabledAt       DateTime?
  whatsappEnabled     Boolean      @default(false)
  whatsappEnabledAt   DateTime?
  minimumSeverity     String       @default("warning")
  inAppMinimumSeverity String  @default("info")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@id([organizationId, username])
  @@index([organizationId, emailEnabled])
  @@index([organizationId, pushEnabled])
  @@index([organizationId, whatsappEnabled])
}

/// One browser endpoint registered by a user for one winery. The endpoint and
/// encryption keys never enter synchronized client state or notification rows.
model AiPushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  username       String
  user           User         @relation(fields: [username], references: [username], onDelete: Cascade)
  endpointHash   String
  endpoint       String       @db.Text
  p256dh         String
  auth           String
  userAgent      String?
  expirationTime BigInt?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, username, endpointHash])
  @@index([organizationId, username, updatedAt])
}

/// Per-user acknowledgement of the latest in-app transition for a finding.
/// A changed event key (severity escalation or lifecycle reopen) makes the
/// finding unread again without changing the server-owned finding itself.
model AiNotificationReadState {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  username       String
  user           User         @relation(fields: [username], references: [username], onDelete: Cascade)
  findingId      String
  eventKey       String
  readAt         DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, username, findingId])
  @@index([organizationId, username, updatedAt])
}

/// Tenant-owned reference material used only after retrieval. Content is kept
/// outside the client-synced winery snapshot so older clients cannot overwrite
/// or fabricate the knowledge supplied to a model call.
model AiKnowledgeDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  sourceLabel    String?
  sourceUrl      String?
  language       String       @default("en")
  agents         Json
  content        String       @db.Text
  contentHash    String
  status         String       @default("active")
  createdBy      String
  creator        User         @relation(fields: [createdBy], references: [username], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  chunks         AiKnowledgeChunk[]

  @@unique([organizationId, contentHash])
  @@index([organizationId, status, updatedAt])
}

/// Deterministic chunks plus optional provider embeddings. Vectors are JSON so
/// the feature works on ordinary Cloud SQL PostgreSQL without requiring pgvector.
model AiKnowledgeChunk {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       AiKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal        Int
  content        String              @db.Text
  searchText     String              @db.Text
  embedding      Json?
  embeddingModel String?
  tokenCount     Int                 @default(0)
  createdAt      DateTime            @default(now())

  @@unique([documentId, ordinal])
  @@index([organizationId, documentId])
}

/// Durable, organization-scoped idempotency claim and replayable command result.
/// The command's business mutation and transition to `completed` are committed
/// in the same PostgreSQL transaction.
model CommandExecution {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commandId      String
  commandType    String
  actorUsername  String
  requestHash    String
  status         String       @default("pending")
  result         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?

  @@unique([organizationId, commandId])
  @@index([organizationId, commandType, createdAt])
}

model OrganizationSubscription {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId                 String
  billingInterval        String
  status                 String
  startsAt               DateTime
  renewsAt               DateTime?
  endsAt                 DateTime?
  trialEndsAt            DateTime?
  promotionCode          String?
  capacityOverrideLiters Float?
  featureOverrides       Json?
  customPriceMinor       Int?
  gracePeriodDays        Int          @default(30)
  capacityExceededAt     DateTime?
  cancelAtPeriodEnd      Boolean      @default(false)
  provider               String?
  providerCustomerId     String?
  providerRecurringId    String?
  providerCardMask       String?
  providerCardExpiry     String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([status, renewsAt])
}

model BillingPayment {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?      @unique
  merchantPaymentId String       @unique
  idempotencyKey    String?      @unique
  kind              String       @default("checkout")
  planId            String
  billingInterval   String
  amountMinor       Int
  currency          String       @default("GEL")
  status            String       @default("created")
  failureCode       String?
  failureMessage    String?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

/// Durable, tenant-scoped delivery state for one task's WhatsApp assignment.
/// Provider webhooks update this row; phone numbers and access tokens are never
/// stored here or projected to the browser.
model WhatsAppDelivery {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId            String
  assigneeUsername  String
  senderUsername    String
  templateName      String
  language          String
  status            String       @default("sending")
  claimToken        String
  providerMessageId String?      @unique
  attemptCount      Int          @default(1)
  errorCode         String?
  errorMessage      String?
  acceptedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  lastWebhookAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, taskId])
  @@index([organizationId, status, updatedAt])
  @@index([status, updatedAt])
}

model SubscriptionRequest {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy              String
  requestType              String
  requestedPlanId          String?
  requestedBillingInterval String?
  message                  String?
  status                   String       @default("pending")
  resolvedBy               String?
  resolvedAt               DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
}

model SubscriptionAudit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUsername  String
  action         String
  previousValue  Json?
  nextValue      Json?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model AnnualProductionUsage {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionYear   Int
  litersProcessed  Float        @default(0)
  source           String       @default("derived_lots")
  lastCalculatedAt DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, productionYear])
  @@index([productionYear, litersProcessed])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [username], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String // "Owner/Admin", "Winemaker", "Lab Technician", "Cellar Worker", "Read-Only"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String // "Owner/Admin", "Winemaker", etc.
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model LoginAttempt {
  key         String    @id
  count       Int       @default(0)
  firstAt     DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model CompanyProfile {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName      String       @default("")
  wineryName       String       @default("")
  country          String       @default("")
  region           String       @default("")
  municipality     String       @default("")
  address          String       @default("")
  contactEmail     String       @default("")
  phone            String       @default("")
  website          String       @default("")
  measurementUnits String       @default("metric")
  currency         String       @default("GEL")
  latitude         Float?
  longitude        Float?
}

model Vessel {
  id                      String
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                    String
  shape                   String
  capacity                Float
  currentVolume           Float
  assignedLotId           String?
  cleaningStatus          String
  lastCleaned             String
  temperature             Float
  coolingJacketActive     Boolean
  targetTemperature       Float?
  lastOperation           String
  locationDetails         String?
  xGrid                   Int?
  yGrid                   Int?
  lastSealedDate          String?
  soilTemperature         Float?
  qvevriNumber            String?
  maraniLocation          String?
  buried                  Boolean?
  lastWashingDate         String?
  limeWashStatus          String?
  waxingStatus            String?
  inspectionNotes         String?
  fillingDate             String?
  grapeVariety            String?
  chachaPercentage        Float?
  stemInclusion           Boolean?
  mixingFrequency         String?
  dailyMixingLog          Json         @default("[]")
  sealingDate             String?
  openingDate             String?
  skinContactDurationDays Int?
  firstRackingDate        String?
  sanitationHistory       Json         @default("[]")

  @@id([organizationId, id])
}

model SecurityAuditEvent {
  id             String   @id @default(cuid())
  eventType      String
  username       String?
  actorUsername  String?
  organizationId String?
  ipHash         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([username, createdAt])
}

model WineLot {
  id             String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  vintage        Int
  variety        String
  vineyardBlock  String
  region         String
  initialVolume  Float
  currentVolume  Float
  wineClass      String
  stage          String
  createdAt      String
  history        Json         @default("[]")
  sensoryProfile Json?

  @@id([organizationId, id])
}

model DailyFermLog {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tankId         String
  lotId          String
  date           String
  temperature    Float
  density        Float
  sugar          Float
  ph             Float
  tastingNotes   String
  capManagement  String
  additives      String
}

model LabAnalysis {
  id                String       @id
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lotId             String
  tankId            String
  date              String
  alcoholPct        Float
  volatileAcid      Float
  freeSo2           Float
  totalSo2          Float
  residualSugar     Float
  ph                Float
  malicAcid         Float
  lacticAcid        Float
  turbidity         Float
  technician        String
  titratableAcidity Float
}

model InventoryItem {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  quantity       Float
  unit           String
  safetyStock    Float
  lastReorder    String?
  supplier       String?
  costPerUnit    Float
  location       String?
  notes          String?
}

model Task {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  priority       String
  dueDate        String
  assignedTo     String?
  status         String
  description    String
  lastModified   String
}

model Note {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  content        String
  category       String
  createdAt      String
  tags           Json         @default("[]")
}

model VineyardBlock {
  id                           String       @id
  organizationId               String
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                         String
  vineyardName                 String
  locationName                 String
  cadastralCode                String?
  officialCadastreDocumentName String?
  landOwner                    String?
  grower                       String?
  municipality                 String?
  community                    String?
  village                      String?
  microzone                    String?
  parcelName                   String?
  parcelArea                   Float?
  latitude                     Float
  longitude                    Float
  area                         Float
  elevation                    Float
  slope                        String
  aspect                       String
  soilType                     String
  grapeVariety                 String
  clone                        String?
  rootstock                    String?
  plantingYear                 Int
  spacing                      String
  rowsCount                    Int
  vinesCount                   Int
  trainingSystem               String
  pruningSystem                String
  irrigationEnabled            Boolean
  farmingStatus                String
  currentPhenology             String
  estimatedHarvestDate         String
  notes                        String
  boundary                     Json?
  gpsPolygon                   Json?
  vineyardCondition            String?
}

model VineyardPlantingProject {
  id                             String       @id
  organizationId                 String
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectName                    String
  landOwnershipDocumentName      String?
  cadastralMapDocumentName       String?
  soilAnalysisDocumentName       String?
  agrotechnicalQuestionnaireName String?
  plannedVarieties               Json         @default("[]")
  rootstock                      String?
  spacing                        String?
  rowDirection                   String?
  irrigationPlan                 String?
  nurseryInvoiceDocumentName     String?
  applicationStatus              String
  approvalDate                   String?
  approvalValidUntil             String?
  soilDepth                      Float?
  pH                             Float?
  organicMatter                  Float?
  caco3                          Float?
  texture                        String?
  ec                             Float?
  exchangeableCa                 Float?
  exchangeableMg                 Float?
  exchangeableNa                 Float?
  hygroscopicWater               Float?
}

model PhenologyRecord {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockId        String
  stage          String
  date           String
  gdd            Float
  confidence     Float
  status         String
  notes          String
  observer       String
}

model SprayRecord {
  id                     String       @id
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockId                String
  date                   String
  targetProblem          String
  productName            String
  activeIngredient       String
  dosePerHa              Float
  waterVolumePerHa       Float
  totalProductUsed       Float
  totalWaterUsed         Float
  operator               String
  machineryUsed          String
  windSpeed              Float
  temperature            Float
  humidity               Float
  preHarvestIntervalDays Int
  reEntryIntervalHours   Int
  notes                  String
}

model ScoutingRecord {
  id                String       @id
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockId           String
  date              String
  locationDetails   String
  problemType       String
  severity          String
  notes             String
  recommendedAction String
  followUpTaskId    String?
}

model SoilAnalysisRecord {
  id               String       @id
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockId          String
  date             String
  pH               Float
  organicMatterPct Float
  nitrogenMgKg     Float
  phosphorusMgKg   Float
  potassiumMgKg    Float
  calciumMgKg      Float
  magnesiumMgKg    Float
  salinityDsm      Float
  notes            String
}

model GrapeSamplingRecord {
  id                   String       @id
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockId              String
  date                 String
  brix                 Float
  pH                   Float
  totalAcidityGL       Float
  berryWeightG         Float
  phenolicMaturity     String
  seedColor            String
  tasteNotes           String
  diseaseCondition     String
  estimatedHarvestDate String
  notes                String
}

model HarvestRecord {
  id                   String       @id
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockId              String
  variety              String
  estimatedHarvestDate String
  estimatedTons        Float
