# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional override for tenant knowledge-base embeddings. The stable default is
# gemini-embedding-2 with 768 output dimensions.
AI_KNOWLEDGE_EMBEDDING_MODEL="gemini-embedding-2"
# Generative models, resolved per slot. AI_MODEL covers the copilot, answer
# explanation, invoice extraction and single-agent analysis. AI_MODEL_DEEP is
# used only for a multi-specialist pass, where interpretation quality is the
# product. AI_MODEL_PLANNER picks a query kind from a fixed list and falls back
# to AI_MODEL; point it at a cheaper model if you want to.
AI_MODEL="gemini-2.5-flash"
AI_MODEL_DEEP="gemini-2.5-pro"
# AI_MODEL_PLANNER="gemini-2.5-flash-lite"

# APP_URL: the canonical public origin this app is served from, with no trailing
# slash — for example "https://vinos.ge".
#
# Every generated link is built from it: the Google OAuth redirect_uri, email
# verification, password reset, invitations, approval review, and AI
# notification deep links. It is pinned rather than derived from the request
# host on purpose — deriving it would let someone set a Host header and receive
# a password-reset link pointing at their own domain.
#
# Because it is pinned, a wrong value is silently wrong for everyone. When a
# custom domain is mapped to Cloud Run, set this to the DOMAIN, not the
# generated *.run.app URL: the session cookie is host-only, so an OAuth sign-in
# that starts on the domain and completes on run.app leaves the user appearing
# signed out on the domain they actually visited.
#
# In production this is set by the deploy workflow from the PUBLIC_APP_URL
# repository variable. The same origin must be registered as an authorized
# redirect URI on the Google OAuth client.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC key used to sign session cookies. REQUIRED in production —
# the server refuses to start without it. Generate a strong value with:
#   openssl rand -hex 32
# Rotating this value invalidates all existing sessions (forces re-login).
SESSION_SECRET=""

# ADMIN_USERNAME: username granted master-admin ("godmode") access. Leave empty
# to disable the master-admin portal entirely.
ADMIN_USERNAME=""

# Google OAuth ("Continue with Google"). Resolved from these env vars first,
# then the in-app setup screen. NEVER hardcode the secret in source — set it
# here locally and via Cloud Run env vars / Secret Manager in production.
# Rotate in Google Cloud Console > Credentials if it was ever committed.
GOOGLE_CLIENT_ID="your_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_rotated_secret_here"
# Keep false in production. If true, the app exposes an in-browser OAuth
# credential setup form; useful locally, risky in production maintenance only.
ALLOW_RUNTIME_OAUTH_CONFIG="false"

# Optional public demo deployment. The demo account is a normal persisted
# account using the same database, sync, weather, and AI APIs as other users.
# No sample vessels, lots, weather, or laboratory records are injected.
DEMO_LOGIN_ENABLED="false"
DEMO_USERNAME="demo"
DEMO_EMAIL="demo@vinos.app"
DEMO_FULL_NAME="Demo Cellar"
DEMO_ROLE="Winemaker"

# PostgreSQL connection string. Strongly recommended for production: when set,
# Postgres (via Prisma) becomes the authoritative store for accounts and
# organization state with optimistic locking; GCS/db.json becomes a backup.
# Free-tier options that work out of the box: Neon (neon.tech) or Supabase —
# copy their pooled connection string here. For Cloud SQL, use the unix-socket
# form and set the CLOUDSQL_INSTANCE secret in the deploy workflow:
#   postgresql://USER:PASSWORD@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=""

# Optional Cloud Run persistence. When GCS_BUCKET is set, db.json is mirrored to
# this bucket/object so user data survives Cloud Run redeploys. Keep Cloud Run
# max instances at 1 while using this single-object db.json backend.
GCS_BUCKET=""
GCS_DB_OBJECT="db.json"
GOOGLE_CLOUD_REGION="europe-west1"

# Outbound email for account verification, password recovery, and invitations.
# SMTP_HOST is REQUIRED for those flows in production; delivery fails closed
# and bearer links are never printed to production logs. Without SMTP_HOST,
# messages are printed only in local development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="VinOS <no-reply@vinos.app>"

# Manual approval of self-service signups. Every new account (password or
# Google) is created locked: the applicant confirms their email as usual, an
# approval request with their name and estate details is emailed to the address
# below, and only an explicit approval unlocks sign-in. Accounts that already
# existed before this gate are treated as approved.
# Set to "false" ONLY to reopen fully self-service registration.
REQUIRE_REGISTRATION_APPROVAL="true"
# Mailbox that receives the requests. Falls back to ADMIN_EMAIL, then MAIL_FROM,
# then SMTP_USER. With none of them set, requests are still queued and can be
# approved from the master admin console (Users tab).
REGISTRATION_APPROVAL_EMAIL=""

# Optional PWA Web Push delivery for task assignments and routed AI findings.
# Generate one VAPID key pair per deployment (`npx web-push generate-vapid-keys`)
# and keep the private key in Secret Manager. The subject must be mailto: or an
# HTTPS URL.
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:alerts@example.com"

# TBC E-Commerce. Leave credentials empty to keep live checkout disabled.
# Recurring must also be enabled for the merchant by TBC before setting true.
TBC_API_KEY=""
TBC_CLIENT_ID=""
TBC_CLIENT_SECRET=""
TBC_API_BASE_URL="https://api.tbcbank.ge"
TBC_RECURRING_ENABLED="false"

# Authenticates the scheduled POST /api/billing/renewals/run job.
BILLING_CRON_SECRET=""

# Optional, deployment-specific VAT wording shown verbatim on pricing screens.
# Examples: "Prices include VAT" or "Prices exclude VAT". Blank hides the line.
BILLING_VAT_LABEL_EN=""
BILLING_VAT_LABEL_KA=""

# Terroir Pulse public aggregation safeguards. These are server-enforced;
# lowering the contributor threshold below 3 is rejected by the application.
TERROIR_PULSE_MIN_CONTRIBUTORS="5"
TERROIR_PULSE_MIN_HECTARES="5"
TERROIR_PULSE_MAX_CONTRIBUTOR_SHARE="0.4"
TERROIR_PULSE_DELAY_DAYS="7"
